{
  "name": "gallery-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ui": "ng test ui",
    "test:all": "ng test gallery-template --watch=false --browsers=ChromeHeadless && ng test ui --watch=false --browsers=ChromeHeadless",
    "storybook": "ng run ui:storybook",
    "build:storybook": "ng run ui:build-storybook",
    "lint": "ng lint gallery-template && ng lint ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src projects --config .dependency-cruiser.cjs",
    "check:styles": "node tools/check-style-boundaries.mjs",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "~22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/language-service": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@types/jasmine": "~4.3.0",
    "angular-eslint": "22.2.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.4.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{scss,json,md,mjs,cjs}": "prettier --write"
  }
}
